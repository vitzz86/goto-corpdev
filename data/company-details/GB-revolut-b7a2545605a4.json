rceUrls":["https://www.revolut.com/news/revolut_receives_central_bank_approval_for_the_acquisition_of_banco_cetelem_in_argentina/"],"reviewedDate":"2026-10-16"},"reviewedRecordCount":4,"reviewedEvidence":[{"id":"finance-revolut-argentina-20260924","date":"2026-09-24","publishedAt":null,"dateBasis":null,"title":"Revolut receives approval to acquire Banco Cetelem in Argentina","summary":"Revolut said Argentina’s central bank approved its purchase of Banco Cetelem Argentina from BNP Paribas Personal Finance. Following completion the bank would be renamed; it would initially offer no public-facing services.","implication":"Use licensed-entity acquisition as a case for separating regulatory approval, operational readiness and commercial launch.","nextAction":"Compare the cost and timetable of licence acquisition, partnership and organic licensing.","url":"https://www.revolut.com/news/revolut_receives_central_bank_approval_for_the_acquisition_of_banco_cetelem_in_argentina/","source":"Revolut","limitations":"Approval does not establish transaction completion or customer launch. Consideration not disclosed."},{"id":"finance-revolut-facepay-20260924","date":"2026-09-24","publishedAt":null,"dateBasis":null,"title":"Revolut pilots facial-recognition checkout with promotional processing fees","summary":"Revolut announced its first facial-recognition payments pilot and promotional zero processing fees.","implication":"Evaluate merchant checkout innovation with explicit consent and fraud controls before scaling biometric payment experiences.","nextAction":"Check opt-in design, biometric data retention, fallback checkout, fraud rates and post-promotion pricing.","url":"https://www.revolut.com/news/revolut_shakes_up_the_high_street_with_first_facial_recognition_payments_and_0_processing_fees/","source":"Revolut","limitations":"Pilot announcement is not evidence of broad adoption or sustainable zero-fee economics."},{"id":"finance-revolut-swiss-20260916","date":"2026-09-16","publishedAt":null,"dateBasis":null,"title":"Revolut applies for Swiss banking licence and commits CHF150m investment","summary":"Revolut announced a Swiss banking licence application and a CHF150 million investment commitment.","implication":"Model expansion as staged regulatory and operating commitments rather than assuming licence application equals launch.","nextAction":"Confirm the investment timetable, regulatory decision and products launched before updating forecasts.","url":"https://www.revolut.com/news/revolut_applies_for_swiss_banking_licence_and_commits_chf_150_million_investment/","source":"Revolut","limitations":"A commitment is not funding received or capital already deployed."},{"id":"insight-revolut-phased-bank-migration-20260311","date":"2026-03-11","publishedAt":null,"dateBasis":null,"title":"Revolut uses phased migration after approval to launch its UK bank","summary":"Revolut announced PRA approval for Revolut Bank UK Ltd to exit mobilisation. It planned phased account migration; new customers could initially still join Revolut Ltd's e-money service.","implication":"Show the legal account provider and protection status for the customer's actual product, not a single group-wide label.","nextAction":"Reconcile issuer, deposit provider, terms, consent and protection wording for each GoPay/Jago product and migration state.","url":"https://www.revolut.com/news/revolut_launches_uk_bank/","source":"Revolut","limitations":"UK permissions and deposit protection do not transfer to Indonesia. This source does not establish that all Revolut customers had migrated on the announcement date."}]}