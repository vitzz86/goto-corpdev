rpretation."},{"id":"ods-editorial-doordash-fuel-cost-recovery-20260421","date":"2026-04-21","publishedAt":null,"dateBasis":null,"title":"DoorDash explains fortnightly fuel-cost adjustments under Australian order","summary":"DoorDash support documentation says delivery base pay is reviewed fortnightly against state-capital fuel prices and a 6 March 2026 baseline. The article links adjustments to the Australian Fair Work Commission fuel-cost recovery order and eligibility to motorised couriers using fuel.","implication":"Model fuel inflation as an explicit driver-supply cost and consider transparent triggers for support.","nextAction":"Validate current order scope, local statutory obligations, pass-through to customers and effect on courier availability.","url":"https://help.doordash.com/en-nz/dashers/article/doordash-fuel-relief-for-dashers","source":"DoorDash support","limitations":"Page has an EN-NZ locale but explicitly references Australian state capitals, Australian pay terms and Fair Work Commission; publication date is not provided."},{"id":"ods-editorial-deliveroo-singapore-exit-20260225","date":"2026-02-25","publishedAt":null,"dateBasis":null,"title":"Deliveroo announces Singapore wind-down after portfolio review","summary":"Deliveroo announced its final Singapore service day would be 4 March after reviewing local conditions. Parent DoorDash framed its wider market decisions around sustainable scale and long-term leadership.","implication":"Treat regional exit and supply migration as possible outcomes of portfolio discipline rather than assume consolidation always expands footprints.","nextAction":"Validate final closure, merchant and courier migration, refunds and whether released demand is profitable to acquire.","url":"https://www.channelnewsasia.com/singapore/deliveroo-singapore-cease-operations-food-delivery-5951801","source":"CNA","limitations":"Announcement is a market exit, not an equity-sale exit or evidence of acquisition proceeds."}]}